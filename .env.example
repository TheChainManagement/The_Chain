# The Chain — env template. Copy to .env.local and fill in values.
# Local dev values come from `supabase start` output. NEVER commit .env.local.

# --- Supabase (public, safe to expose on the client) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase (server-only — service role bypasses RLS) ---
# NEVER expose this on the client.
SUPABASE_SERVICE_ROLE_KEY=

# --- Workflow DevKit (Phase 5E) ---
# WORKFLOW_RUNTIME_URL=

# --- Vercel AI Gateway (Phase 6, AI insights layer) ---
# AI_GATEWAY_API_KEY=

# --- QuickBooks Online OAuth (Phase 6, Block 6 QBO feature) ---
# Real values go in .env.local (gitignored), NOT here. This file is committed.
# From your app's "Keys & OAuth" on developer.intuit.com.
# QBO_CLIENT_ID=
# QBO_CLIENT_SECRET=
# 'sandbox' for the test company; 'production' for live books.
# QBO_ENVIRONMENT=sandbox
# Must match a Redirect URI registered on the app exactly.
# QBO_REDIRECT_URI=http://localhost:3100/api/qbo/oauth/callback
# AES-256-GCM key for encrypting QBO tokens at rest. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# QBO_TOKEN_ENC_KEY=

# --- Stripe billing (Block 16) ---
# Real values go in .env.local (gitignored). Use TEST keys (sk_test_/pk_test_)
# until going live. From dashboard.stripe.com → Developers → API keys (test mode).
# STRIPE_SECRET_KEY=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Price IDs printed by: node --env-file=.env.local scripts/stripe-seed.mjs
# STRIPE_PRICE_STARTER=
# STRIPE_PRICE_GROWTH=
# STRIPE_PRICE_PRO=
# Webhook signing secret. Local: `stripe listen --forward-to localhost:3100/api/webhooks/stripe`.
# STRIPE_WEBHOOK_SECRET=
